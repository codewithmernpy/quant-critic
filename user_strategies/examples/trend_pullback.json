{
  "name": "trend_pullback",
  "description": "Example causal trend pullback: close above EMA(200) and RSI(14) crosses above 40 (mirrored for shorts), with 2.0x ATR(14) protective stop.",
  "long_rules": [
    {
      "left": {
        "kind": "indicator",
        "indicator": "close"
      },
      "operator": "greater_than",
      "right": {
        "kind": "indicator",
        "indicator": "ema",
        "period": 200
      }
    },
    {
      "left": {
        "kind": "indicator",
        "indicator": "rsi",
        "period": 14
      },
      "operator": "crosses_above",
      "right": {
        "kind": "number",
        "value": 40.0
      }
    }
  ],
  "short_rules": [],
  "mirror_long_for_short": true,
  "combine": "all",
  "exit": {
    "atr_period": 14,
    "atr_stop_mult": 2.0,
    "tp_r": 2.5,
    "max_bars": 36,
    "exit_rules": [],
    "exit_combine": "any"
  },
  "notes": "Example specification shipped in user_strategies/examples/ (not a performance claim).",
  "unsupported": []
}
