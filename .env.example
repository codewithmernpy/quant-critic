# Anthropic API key for --ai mode (optional; offline deterministic critic works without it)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude model identifier used by QuantCritic AI Critic
QC_MODEL=claude-opus-5-5

# Set to 1 to force deterministic offline critic even if ANTHROPIC_API_KEY is set
QC_OFFLINE=0
